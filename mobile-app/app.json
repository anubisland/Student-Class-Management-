{
  "name": "StudentApp",
  "displayName": "Student Class Management",
  "expo": {
    "name": "Student Class Management",
    "slug": "student-class-management",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#3B82F6"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.studentclass.management"
    },
    "android": {
      "package": "com.studentclass.management",
      "versionCode": 1,
      "permissions": [
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_EXTERNAL_STORAGE"
      ]
    },
    "plugins": [
      [
        "expo-document-picker",
        {
          "iCloudContainerEnvironment": "Production"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "1f26dae8-592d-48cc-a287-0663478a7834"
      }
    }
  }
}
